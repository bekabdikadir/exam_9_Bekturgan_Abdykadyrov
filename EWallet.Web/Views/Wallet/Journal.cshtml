@model JournalViewModel
@{
    ViewData["Title"] = L["Nav_Journal"];
}

<h1 class="h4 mb-3">@L["Journal_Title"]</h1>

<form asp-controller="Wallet" asp-action="Journal" method="get" class="row g-3 align-items-end mb-4">
    <div class="col-sm-4 col-md-3">
        <label asp-for="DateFrom" class="form-label"></label>
        <input asp-for="DateFrom" name="dateFrom" class="form-control" type="date" />
    </div>
    <div class="col-sm-4 col-md-3">
        <label asp-for="DateTo" class="form-label"></label>
        <input asp-for="DateTo" name="dateTo" class="form-control" type="date" />
    </div>
    <div class="col-sm-4 col-md-4">
        <button type="submit" class="btn btn-primary">@L["Btn_Filter"]</button>
        <a class="btn btn-outline-secondary" asp-action="Journal">@L["Btn_Reset"]</a>
    </div>
</form>

@if (Model.Items.Count == 0)
{
    <div class="alert alert-info">@L["Journal_Empty"]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
            <tr>
                <th>@L["Journal_Date"]</th>
                <th>@L["Journal_Type"]</th>
                <th class="text-end">@L["Journal_Amount"]</th>
                <th>@L["Journal_Counterparty"]</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Items)
            {
                var incoming = item.Type == TransactionType.TopUp || item.Type == TransactionType.TransferIn;
                var isTransfer = item.Type == TransactionType.TransferIn || item.Type == TransactionType.TransferOut;
                <tr>
                    <td>@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@L["TransactionType_" + item.Type]</td>
                    <td class="text-end fw-semibold @(incoming ? "text-success" : "text-danger")">
                        @(incoming ? "+" : "-")@item.Amount.ToMoney()
                    </td>
                    <td>
                        @if (string.IsNullOrEmpty(item.Counterparty))
                        {
                            <span>&mdash;</span>
                        }
                        else if (isTransfer)
                        {
                            @L["Journal_Account", item.Counterparty]
                        }
                        else
                        {
                            @item.Counterparty
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
